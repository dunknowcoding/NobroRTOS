        "test",
        "--target",
        "{host_target}",
        "--locked",
        "-p",
        "nobro-hal"
      ],
      "claim_scopes": [
        {
          "platform": "nrf52840",
          "composition": "native-nosd",
          "capabilities": ["timebase", "deadline", "event", "dma_completion", "servo", "i2c", "spi", "lease"]
        },
        {
          "platform": "nrf52840",
          "composition": "native-s140",
