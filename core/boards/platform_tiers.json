{
  "schema": "nobro-platform-support-v2",
  "feature_registry": "core/boards/feature_providers.json",
  "hal_contract": "core/boards/hal_contract_v2.json",
  "reference_platform": "nrf52840",
  "providers": [
    "timebase",
    "deadline",
    "event",
    "dma_completion",
    "gpio",
    "irq",
    "uart",
    "byte_io",
    "adc",
    "pwm",
    "servo",
    "pulse",
    "i2c",
    "spi",
    "usb",
    "watchdog",
    "rtc",
    "flash",
    "reset",
    "power",
    "cache",
    "multicore",
    "lease"
  ],
  "facade_offers": [
    "timebase",
    "deadline",
    "adc",
    "pwm",
    "i2c",
    "spi",
    "byte_io"
  ],
  "tiers": {
    "deep": "each declared native composition satisfies its versioned deep profile with exact compiled witnesses",
    "provider": "one or more portable provider traits implemented for the target",
    "core": "target startup and status path available; portable peripheral providers are incomplete",
    "absent": "no maintained target integration"
  },
  "evidence_kinds": {
    "host-test": "executable host-side contract or state-machine test",
    "target-build": "successful compilation for the declared target; not physical behavior"
  },
  "maturities": {
    "implemented": "the declared surface is present and has the cited non-physical evidence",
    "experimental": "the declared surface is usable but may change incompatibly"
  },
  "runners": {
    "rust-matrix": {
      "workflow_job": "rust-matrix",
      "receipt_driver": ".github/workflows/gates.yml",
      "identity_probes": [
        {
          "id": "python",
          "command": ["python", "--version"],
          "expected": "^Python 3\\."
        },
        {
          "id": "rustc",
          "command": ["rustc", "-vV"],
          "expected": "^release: 1\\.97\\.0$"
        },
        {
          "id": "cargo",
          "command": ["cargo", "-V"],
          "expected": "^cargo 1\\.97\\.0 "
        }
      ]
    },
    "cross-mcu": {
      "workflow_job": "cross-mcu",
      "receipt_driver": "tools/checks/ci_matrix.sh",
      "identity_probes": [
        {
          "id": "python",
          "command": ["python", "--version"],
          "expected": "^Python 3\\."
        },
        {
          "id": "rustc",
          "command": ["rustc", "-vV"],
          "expected": "^release: 1\\.97\\.0$"
        },
        {
          "id": "cargo",
          "command": ["cargo", "-V"],
          "expected": "^cargo 1\\.97\\.0 "
        },
        {
          "id": "arm-gcc",
          "command": ["arm-none-eabi-gcc", "--version"],
          "expected": "^arm-none-eabi-gcc(?:\\.exe)? "
        },
        {
          "id": "xtensa-gcc",
          "command": ["xtensa-esp32s3-elf-gcc", "--version"],
          "expected": "^xtensa-esp(?:32s3)?-elf-gcc(?:\\.exe)? "
        }
      ]
    },
    "arduino-package": {
      "workflow_job": "arduino-package",
      "receipt_driver": ".github/workflows/gates.yml",
      "identity_probes": [
        {
          "id": "python",
          "command": ["python", "--version"],
          "expected": "^Python 3\\."
        },
        {
          "id": "arduino-cli",
          "command": ["arduino-cli", "version"],
          "expected": "Version: 1\\.5\\.1"
        },
        {
          "id": "board-packages",
          "command": ["arduino-cli", "core", "list"],
          "expected": "(?s)(?=.*arduino:avr\\s+1\\.8\\.8)(?=.*arduino:samd\\s+1\\.8\\.14)(?=.*arduino:renesas_uno\\s+1\\.6\\.0)(?=.*esp32:esp32\\s+3\\.3\\.10)"
        }
      ]
    },
    "arduino-nrf-package": {
      "workflow_job": "arduino-nrf-package",
      "receipt_driver": ".github/workflows/gates.yml",
      "identity_probes": [
        {
          "id": "python",
          "command": ["python", "--version"],
          "expected": "^Python 3\\."
        },
        {
          "id": "arduino-cli",
          "command": ["arduino-cli", "version"],
          "expected": "Version: 1\\.5\\.1"
        },
        {
          "id": "board-package",
          "command": ["arduino-cli", "core", "list"],
          "expected": "arduinonrf:nrf52\\s+0\\.3\\.11"
        }
      ]
    }
  },
  "evidence_gates": {
